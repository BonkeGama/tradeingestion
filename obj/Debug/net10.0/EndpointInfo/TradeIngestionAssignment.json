{
  "openapi": "3.1.1",
  "info": {
    "title": "TradeIngestionAssignment | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7031"
    },
    {
      "url": "http://localhost:5106"
    }
  ],
  "paths": {
    "/api/snapshots/{accountId}": {
      "get": {
        "tags": [
          "Snapshots"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshotResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshotResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioSnapshotResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/trades": {
      "post": {
        "tags": [
          "Trades"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TradeSubmissionRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/TradeSubmissionRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/TradeSubmissionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/TradeSubmissionResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeSubmissionResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/TradeSubmissionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PortfolioPositionResponse": {
        "type": "object",
        "properties": {
          "isin": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "quantity": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "average_unit_cost_usd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "market_price_usd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "market_value_usd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "unrealized_pnl_usd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "PortfolioSnapshotResponse": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "snapshot_date": {
            "type": "string",
            "format": "date"
          },
          "total_market_value_usd": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "positions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioPositionResponse"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "TradeSubmissionRequest": {
        "required": [
          "external_ref",
          "account_id",
          "isin",
          "symbol",
          "side"
        ],
        "type": "object",
        "properties": {
          "external_ref": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "isin": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "pattern": "BUY|SELL",
            "type": "string"
          },
          "quantity": {
            "minimum": 0.000001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "price": {
            "minimum": 0.000001,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "trade_date": {
            "type": "string",
            "format": "date"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TradeSubmissionResponse": {
        "type": "object",
        "properties": {
          "trade_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "applied_trade_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "outcome": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Snapshots"
    },
    {
      "name": "Trades"
    }
  ]
}