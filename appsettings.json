{
  "ConnectionStrings": {
    "TradeDb": "Server=localhost;Database=TradeIngestionAssignmentDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "TradeProcessing": {
    "EnableDuplicateCorrectionHandling": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*"
}
